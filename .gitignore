# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# secrets / local env — never commit production credentials
.env
.env.*
*.env
!.env.example
test.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Runtime / CMS editor data (lives on VPS, not in git)
# Admins & editors change these via Payload admin in production.
# ---------------------------------------------------------------------------

# Uploaded media (Payload Media collection → cwd/media)
/media/*
!/media/.gitkeep

# Docker Postgres named volume exports if copied into project root
/pgdata/

# Local DB dumps / exports editors or ops may create on the server
*.sql
*.sql.gz
*.dump
*.pgdump
/backups/
/dumps/

# Ad-hoc migration / admin script backups (local only)
scripts/.projekty-content-backup.json
scripts/.admin-field-consistency-backup.json
scripts/.*-backup*.json

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Editor local
.cursor/
.vscode/
*.swp
