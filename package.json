{
  "name": "nazemi",
  "version": "1.0.0",
  "description": "NaZemi website — Payload CMS + Next.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/index.ts",
    "db:push": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/push-schema.ts",
    "media:regenerate": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/regenerate-media-sizes.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.87.1",
    "@payloadcms/email-nodemailer": "3.87.1",
    "@payloadcms/live-preview-react": "3.87.1",
    "@payloadcms/next": "3.87.1",
    "@payloadcms/plugin-search": "3.87.1",
    "@payloadcms/richtext-lexical": "3.87.1",
    "@payloadcms/ui": "3.87.1",
    "cross-env": "^7.0.3",
    "czech-stemmer": "^0.1.0",
    "dotenv": "16.4.7",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.8.1",
    "next": "16.2.12",
    "payload": "3.87.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.3",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.4",
    "typescript": "5.7.3",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "esbuild": "0.28.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
