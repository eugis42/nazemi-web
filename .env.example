# Local development (Postgres via docker-compose.yml or host)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nazemi

# Required — long random string (e.g. openssl rand -hex 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Required in production — draft preview / live preview URL signing
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE

# Public site URL (no trailing slash). Required in production behind HTTPS.
# NEXT_PUBLIC_SERVER_URL=https://nazemi.feelnoth.ing

# Docker Postgres (docker-compose.prod.yml)
# POSTGRES_DB=nazemi
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=

# One-shot schema push after deploy/schema change (prefer `npm run db:push` on VPS).
# Never leave enabled long-term in production.
# PAYLOAD_DATABASE_PUSH=true
