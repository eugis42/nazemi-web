# Local development (Postgres via docker-compose.yml or host)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nazemi

# Required — long random string (e.g. openssl rand -hex 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Required in production — draft preview / live preview URL signing
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE

# Public site URL (no trailing slash). Required in production behind HTTPS.
# NEXT_PUBLIC_SERVER_URL=https://novy.nazemi.cz

# Docker Postgres (docker-compose.prod.yml) — app uses 127.0.0.1:5433
# POSTGRES_DB=nazemi
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=

# SMTP (Gmail relay / IP allowlist). Omit SMTP_HOST locally → console email.
# SMTP_HOST=smtp-relay.gmail.com
# SMTP_PORT=587
# SMTP_FROM=web@nazemi.cz
# SMTP_FROM_NAME=NaZemi

# First admin on a fresh DB: `npx tsx scripts/set-prod-admin.ts`
# PROD_ADMIN_EMAIL=eugen.korda@me.com
# PROD_ADMIN_NAME=Eugen Korda
# PROD_ADMIN_PASSWORD=

# One-shot schema push after deploy/schema change (prefer `npm run db:push` on VPS).
# Never leave enabled long-term in production.
# PAYLOAD_DATABASE_PUSH=true
